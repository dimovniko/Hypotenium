# Copy to .env and fill in. Everything has a working default except the API key.

# API key of the model provider referenced in config/models.yaml as ${LLM_API_KEY}.
# The default config talks to OpenAI; any OpenAI-compatible provider works —
# see the commented alternatives in config/models.yaml.
LLM_API_KEY=

# Secret for signing session cookies (JWT). Generate one: openssl rand -hex 32
JWT_SECRET=change-me-to-random-string

# First admin account, created on the first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Where the frontend is served (CORS) and where the browser reaches the API.
# For a server deployment set both to public URLs, e.g. https://research.example.com
# and https://api.research.example.com (NEXT_PUBLIC_API_URL is baked in at build time).
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Optional ---------------------------------------------------------------------

# Local GigaAM transcription container (Russian ASR, audio stays on the machine).
# Heavy image (~1 GB + model weights); enable only if you need it and point the
# transcription slot in config/models.yaml to http://transcriber:9000/v1
# COMPOSE_PROFILES=gigaam

# GigaChat (Sber) direct API — see the commented block in config/models.yaml
# GIGACHAT_AUTH_KEY=

# Any other provider keys you reference from config/models.local.yaml
# POLZA_API_KEY=
